# Telegram bot orqali contact forma xabarlarini qabul qilish uchun.
# Bu qiymatlarni Vercel loyihasi -> Settings -> Environment Variables bo'limiga qo'shing.
# Hech qachon .env faylini Git'ga commit qilmang (u .gitignore'da).

TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here
